# Copy to .env and fill in. Never commit .env.

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://comp523:comp523@localhost:5432/scheduling?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails allowed to modify assignments (NFR-6)
ADMIN_EMAILS="you@unc.edu"

# Integrations: "mock" (default) uses the dummy data in fixtures/; "live" calls the real service; "off" skips it.
GOOGLE_CALENDAR_MODE="mock"
TWENTYFIVE_LIVE_MODE="mock"   # set to "off" when using real Google data, so dummy courses don't mix in

# Google Calendar live mode — OAuth client of type "Desktop app" (README: Connecting Google Calendar)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Leave false for the real department calendars. true = allow push/assign to write (use test calendars).
GOOGLE_CALENDAR_WRITE="false"
CALENDAR_TIMEZONE="America/New_York"

# 25Live — fill in once the client gives us API access (FR-10)
TWENTYFIVE_LIVE_BASE_URL=""
TWENTYFIVE_LIVE_USERNAME=""
TWENTYFIVE_LIVE_PASSWORD=""
