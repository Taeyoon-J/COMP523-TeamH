# Copy to .env and fill in. Never commit .env.

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://comp523:comp523@localhost:5432/scheduling?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails allowed to modify assignments (NFR-6)
ADMIN_EMAILS="you@unc.edu"

# Integrations: "mock" (default) uses the dummy data in fixtures/; "live" calls the real service; "off" skips it.
GOOGLE_CALENDAR_MODE="mock"
TWENTYFIVE_LIVE_MODE="mock"
# Which dummy 25Live data to serve: "demo" (small made-up schedule) or "fall2026" (built from the real
# room calendars; use it together with GOOGLE_CALENDAR_MODE="live")
TWENTYFIVE_LIVE_FIXTURE="demo"

# Events spreadsheet: "mock" writes .mock-data/events-sheet.csv, "live" writes the Google Sheet below
# (needs the Google Sheets API enabled and a new `npm run cli -- google login`), "off" disables it.
SHEETS_MODE="mock"
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_TAB="Events"

# Local development only: act as this admin in the web app without signing in.
AUTH_DEV_ADMIN=""

# Google Calendar live mode — OAuth client of type "Desktop app" (README: Connecting Google Calendar)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Leave false for the real department calendars. true = allow push/assign to write (use test calendars).
GOOGLE_CALENDAR_WRITE="false"
CALENDAR_TIMEZONE="America/New_York"

# 25Live — fill in once the client gives us API access (FR-10)
TWENTYFIVE_LIVE_BASE_URL=""
TWENTYFIVE_LIVE_USERNAME=""
TWENTYFIVE_LIVE_PASSWORD=""
